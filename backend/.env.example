# Evolus credentials and IDs are server-side only.
# The verified guide documents extraction through an agent-scoped endpoint;
# Configure the verified Evolus agent and extractor IDs; keep API credentials server-side.
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
# Evolus model IDs use applicationId:agentId format.
EVOLUS_EXPLAINER_MODEL=
EVOLUS_INTERVIEWER_MODEL=
EVOLUS_TRANSLATE_TOOL_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_SECONDS=3600
MAX_UPLOAD_MB=20
MAX_QUESTIONS=10

EVOLUS_TIMEOUT_SECONDS=45
OFFLINE_FALLBACK_ENABLED=true
DOCUMENT_RETENTION_SECONDS=3600
